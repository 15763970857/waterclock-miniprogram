page {
  background: linear-gradient(180deg, #f2fbff 0%, #e6f6fe 45%, #dff0fb 100%);
  color: #0b3b52;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(150deg, #38bdf8 0%, #0891b2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.brand-drop {
  width: 26rpx;
  height: 26rpx;
  background: #ffffff;
  border-radius: 0 50% 50% 50%;
  transform: rotate(45deg);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.brand-sub {
  font-size: 24rpx;
  color: #8fa9b8;
  margin-top: 6rpx;
  line-height: 1.2;
}

.goal-chip {
  font-size: 24rpx;
  color: #0284c7;
  font-weight: 600;
  background: rgba(14, 165, 233, 0.09);
  border: 1rpx solid rgba(14, 165, 233, 0.16);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(14, 165, 233, 0.1);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(3, 90, 130, 0.08);
  box-sizing: border-box;
}

/* 按钮重置 */
.btn-main,
.btn-confirm,
.btn-ghost,
.btn-undo,
.chip {
  margin: 0;
  padding: 0;
  line-height: normal;
  border: none;
  border-radius: 0;
}

.btn-main::after,
.btn-confirm::after,
.btn-ghost::after,
.btn-undo::after,
.chip::after {
  border: none;
}

/* 列表头 */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.list-count {
  font-size: 22rpx;
  color: #8fa9b8;
}

/* 数据存储说明（今日/周报页脚小字） */
.data-note {
  display: block;
  margin-top: 28rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #9db4c2;
  text-align: center;
}

/* 水滴图标（纯 CSS，避免引入图片资源） */
.drop {
  width: 84rpx;
  height: 84rpx;
  background: linear-gradient(165deg, #67e8f9 0%, #0891b2 100%);
  border-radius: 0 50% 50% 50%;
  transform: rotate(45deg);
}
